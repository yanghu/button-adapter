VIA_ENABLE = yes
VIAL_ENABLE = yes
VIAL_INSECURE = no

# Enable full Vial live-editing capabilities (Tap Dance for Hold-PTT / Double-Tap-Toggle, Combos for OS switch)
TAP_DANCE_ENABLE = yes
COMBO_ENABLE = yes
KEY_OVERRIDE_ENABLE = yes
QMK_SETTINGS = yes

# Per-key symmetric defer debounce for crisp mechanical arcade switches
DEBOUNCE_TYPE = sym_defer_pk
